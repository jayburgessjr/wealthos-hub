# Copy to .env and fill in real values. Never commit .env.
# All VITE_* values are shipped to the browser bundle — only put
# values that are safe to expose publicly here.

# Supabase (publishable / anon key only — never the service role key)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional client-side analytics / monitoring (uncomment when wired)
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
